# Concierge (intent + synthesis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Scout — GMI Cloud (OpenAI-compatible, used for place extraction)
GMI_CLOUD_API_KEY=
GMI_CLOUD_BASE_URL=https://api.gmi-serving.com/v1
GMI_CLOUD_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct

# Scout — Exa (semantic search over reddit.com via includeDomains)
EXA_API_KEY=

# Official Events — Google Maps (Places New + Distance Matrix)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Live-demo fallback: route serves canned-responses.json instead of calling agents
NEXT_PUBLIC_DEMO_MODE=true

# RocketRide — synthesis runs through pipelines/synthesize.pipe when reachable.
# Local-engine defaults below; if the engine is down the Concierge falls back to
# direct Gemini streaming and emits a "rocketride-fallback" trace event.
# To enable: open VSCode → RocketRide sidebar → "Connect to Server".
ROCKETRIDE_URI=ws://localhost:5565/task/service
ROCKETRIDE_APIKEY=local-dev
# Set to "true" to skip RocketRide entirely and always use direct Gemini:
# ROCKETRIDE_DISABLED=false
